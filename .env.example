# Copy to .env and adjust. Never commit .env.

# --- Backend ---
# SQLite for local dev; docker-compose overrides this with PostgreSQL.
DATABASE_URL=sqlite:///./crm.db
# At least 32 characters. Fine for local dev; for anything public generate a new one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-key-change-me-before-deploying
ACCESS_TOKEN_EXPIRE_MINUTES=480
APP_TIMEZONE=Asia/Vientiane

# --- PostgreSQL (docker compose, Phase 11) ---
POSTGRES_USER=crm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=crm
