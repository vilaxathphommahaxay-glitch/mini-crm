# Copy to .env and adjust. Never commit .env.

# --- Backend ---
# SQLite for local dev; docker-compose overrides this with PostgreSQL.
DATABASE_URL=sqlite:///./crm.db
# At least 32 characters. Fine for local dev; for anything public generate a new one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-key-change-me-before-deploying
ACCESS_TOKEN_EXPIRE_MINUTES=480
APP_TIMEZONE=Asia/Vientiane

# --- PostgreSQL (docker compose, Phase 11) ---
POSTGRES_USER=crm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=crm

# --- Language ---
# Language new visitors start in: lo (Lao) or en (English). Empty = follow the browser.
# People can always switch with the EN / ລາວ buttons; their choice is remembered.
# Changing it needs a rebuild: docker compose up --build
APP_LOCALE=
# Language of the demo data (names, companies, deals). Defaults to APP_LOCALE, then en.
# Only used when the database is empty; set SEED_DEMO_DATA=false to start with no demo data.
SEED_LANGUAGE=
SEED_DEMO_DATA=true

# --- Automatic backups (the `backup` service writes to ./backups) ---
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_DAYS=14
